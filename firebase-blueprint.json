{
  "entities": {
    "users": {
      "title": "User Accounts",
      "description": "User profiles, roles, assigned poultry houses, and authentication records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "designatedHouses": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "registeredAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "securityQuestion": { "type": "string" },
        "securityAnswer": { "type": "string" },
        "contactNumber": { "type": "string" }
      },
      "required": ["id", "username", "fullName", "role", "status"]
    },
    "flocks": {
      "title": "Flock Houses",
      "description": "Flock metadata, bird counts, breed details, pen allocations, and house statuses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "houseNumber": { "type": "string" },
        "breed": { "type": "string" },
        "loadingDateMale": { "type": "string" },
        "loadingDateFemale": { "type": "string" },
        "initialMales": { "type": "number" },
        "initialFemales": { "type": "number" },
        "currentMales": { "type": "number" },
        "currentFemales": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "pens": { "type": "array" }
      },
      "required": ["id", "houseNumber", "breed", "status"]
    },
    "eggRecords": {
      "title": "Daily Egg Collection Records",
      "description": "Daily egg production logs, grades, defects, collection times, and logging metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "flockId": { "type": "string" },
        "houseNumber": { "type": "string" },
        "date": { "type": "string" },
        "intactTotal": { "type": "number" },
        "brokenTotal": { "type": "number" },
        "totalEggs": { "type": "number" },
        "loggedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "houseNumber", "date", "loggedBy"]
    },
    "feedRecords": {
      "title": "Feed Consumption Records",
      "description": "Daily feed allocation, feed types, consumption in kg, male/female distribution",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "houseNumber": { "type": "string" },
        "date": { "type": "string" },
        "feedType": { "type": "string" },
        "quantityKg": { "type": "number" },
        "loggedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "houseNumber", "date", "feedType", "quantityKg"]
    },
    "depletions": {
      "title": "Depletion & Mortality Records",
      "description": "Daily mortality, culls, missex, and reason details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "houseNumber": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "maleCount": { "type": "number" },
        "femaleCount": { "type": "number" },
        "loggedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "houseNumber", "date", "category", "loggedBy"]
    },
    "medAdmins": {
      "title": "Medication & Vaccine Administration",
      "description": "Medication, vaccination, vitamin administration logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "houseNumber": { "type": "string" },
        "date": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "administeredBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "houseNumber", "date", "productName"]
    },
    "bodyWeights": {
      "title": "Weekly Body Weight Logs",
      "description": "Body weight sampling and uniformity tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "houseNumber": { "type": "string" },
        "date": { "type": "string" },
        "averageWeight": { "type": "number" },
        "loggedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "houseNumber", "date"]
    },
    "biosecurityLogs": {
      "title": "Biosecurity Checklists",
      "description": "Daily biosecurity compliance and visitor protocols",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "requirementId": { "type": "string" },
        "status": { "type": "string" },
        "loggedBy": { "type": "string" }
      },
      "required": ["id", "date", "requirementId"]
    },
    "farmProfile": {
      "title": "Farm Configuration Profile",
      "description": "Farm metadata, location, company name, default standards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "manager": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  }
}
